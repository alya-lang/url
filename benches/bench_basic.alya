# Benchmark suite for url package
import "std/bench"
import "../src/lib.alya" as url

function main()
    let runner = bench_runner("url Micro-Benchmarks")

    # 1. URL parsing benchmark
    bench_start(runner, 2000)
    let i = 0
    while i < 2000
        url::parse("https://alice:secret@api.example.com:8443/v1/users?role=admin&active=true#section-2")
        i += 1
    end
    bench_stop(runner, "url::parse() 2k calls")

    # 2. URL formatting benchmark
    let u = url::parse("https://alice:secret@api.example.com:8443/v1/users?role=admin&active=true#section-2")
    bench_start(runner, 2000)
    let j = 0
    while j < 2000
        url::format(u)
        j += 1
    end
    bench_stop(runner, "url::format() 2k calls")

    # 3. Query string parsing & serialization benchmark
    bench_start(runner, 2000)
    let k = 0
    while k < 2000
        let sp = url::search_params_from("foo=1&bar=2&baz=hello%20world&page=10")
        url::search_params_to_string(sp)
        k += 1
    end
    bench_stop(runner, "search_params_from() + to_string() 2k calls")

    # 4. URL normalization benchmark
    bench_start(runner, 2000)
    let m = 0
    while m < 2000
        url::normalize("HTTP://EXAMPLE.COM:80/a/b/../c/./d?z=2&a=1")
        m += 1
    end
    bench_stop(runner, "url::normalize() 2k calls")

    bench_summary(runner)
end

main()
