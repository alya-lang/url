## Demo of the url package (WHATWG / RFC 3986)
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as url

function main()
    say "═══════════════════════════════════════════════════════════════════"
    say "  Alya URL Package Showcase (WHATWG & RFC 3986 Standard)"
    say "═══════════════════════════════════════════════════════════════════"

    # 1. Parsing a complex URL
    say "\n[1] Parsing Complex URL:"
    let raw = "https://developer:token123@api.alya-lang.org:8443/v1/packages/search?q=crypto&page=1#results"
    let u = url::parse(raw)
    say f"  Scheme   : {u.scheme}"
    say f"  User     : {u.username}"
    say f"  Password : {u.password}"
    say f"  Host     : {u.host}"
    say f"  Port     : {u.port}"
    say f"  Path     : {u.path}"
    say f"  Query    : {u.query}"
    say f"  Fragment : {u.fragment}"
    let origin = url::url_origin(u)
    let is_https = url::url_is_https(u)
    say f"  Origin   : {origin}"
    say f"  Is HTTPS : {is_https}"

    @cfg(feature = "query")
    demo_query()

    @cfg(feature = "builder")
    demo_builder()

    # 4. Relative URL Reference Resolution (RFC 3986)
    say "\n[4] Resolving Relative References:"
    let base = "https://example.com/docs/api/v1/overview"
    let join_auth = url::join(base, "auth")
    let join_v2 = url::join(base, "../v2/overview")
    let join_root = url::join(base, "/root")
    say f"  Base         : {base}"
    say f"  Join 'auth'  : {join_auth}"
    say f"  Join '../v2' : {join_v2}"
    say f"  Join '/root' : {join_root}"

    @cfg(feature = "normalize")
    demo_normalize()

    say "\n✓ Showcase completed successfully!"
end

@cfg(feature = "query")
function demo_query()
    # 2. Working with UrlSearchParams
    say "\n[2] UrlSearchParams Manipulation:"
    let sp = url::search_params_from(u.query)
    let q_val = url::search_params_get(sp, "q")
    let page_val = url::search_params_get(sp, "page")
    say f"  Param 'q'    : {q_val}"
    say f"  Param 'page' : {page_val}"
    url::search_params_append(sp, "sort", "stars")
    url::search_params_set(sp, "page", "2")
    let new_q = url::search_params_to_string(sp)
    say f"  New Query    : {new_q}"
end

@cfg(feature = "builder")
function demo_builder()
    # 3. Fluent URL Builder
    say "\n[3] Constructing URL with Fluent Builder:"
    let b = url::builder()
    url::builder_scheme(b, "https")
    url::builder_host(b, "github.com")
    url::builder_path(b, "/alya-lang")
    url::builder_append_path(b, "url")
    url::builder_param(b, "tab", "readme-ov-file")
    url::builder_fragment(b, "contributing")
    let built_url = url::builder_to_string(b)
    say f"  Built URL    : {built_url}"
end

@cfg(feature = "normalize")
function demo_normalize()
    # 5. URL Normalization
    say "\n[5] URL Normalization:"
    let messy = "HTTP://EXAMPLE.COM:80/a/b/../c/./d?z=2&a=1"
    let normalized = url::normalize(messy)
    say f"  Messy        : {messy}"
    say f"  Normalized   : {normalized}"
end
main()
