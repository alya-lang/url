## # url
##
## WHATWG and RFC 3986 compliant URL library for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./core/path.alya"
import "./core/parser.alya"
import "./core/percent.alya"
@cfg(feature = "query")
import "./core/query.alya"
@cfg(feature = "builder")
import "./core/builder.alya"
@cfg(feature = "normalize")
import "./core/normalize.alya"

# ═══════════════════════════════════════════════════════════════
# High-Level Idiomatic Public API
# ═══════════════════════════════════════════════════════════════

## Parses a URL string into a `Url` struct.
##
## ### Parameters
## - `raw_url`: Raw URL value.
##
## ### Returns
## The parsed `Url` instance.
##
## ### Examples
## ```alya
## let u = parse("https://example.com:8080/p?q=1#frag")
## ```
pub function parse(raw_url) -> Url
    return url_parse(raw_url)
end

## Formats a `Url` struct into a URL string.
##
## ### Parameters
## - `u`: Target `Url` instance.
##
## ### Returns
## The formatted URL string.
pub function format(u: Url) -> string
    return url_format(u)
end

## Converts a `Url` struct into a URL string.
##
## ### Parameters
## - `u`: Target `Url` instance.
##
## ### Returns
## The formatted URL string.
pub function to_string(u: Url) -> string
    return url_format(u)
end

## Creates a new fluent URL builder.
##
## Requires the `builder` feature (default-on).
##
## ### Returns
## The new `UrlBuilder` instance.
@cfg(feature = "builder")
pub function builder() -> UrlBuilder
    return url_builder()
end

## Creates a new empty `UrlSearchParams` container.
##
## Requires the `query` feature (default-on).
##
## ### Returns
## The new container instance.
@cfg(feature = "query")
pub function search_params() -> UrlSearchParams
    return search_params_new()
end

## Creates `UrlSearchParams` from a query string.
##
## Requires the `query` feature (default-on).
##
## ### Parameters
## - `query_str`: Raw query value.
##
## ### Returns
## The populated container instance.
@cfg(feature = "query")
pub function search_params_from(query_str) -> UrlSearchParams
    return search_params_from_string(query_str)
end

## Normalizes a URL string per RFC 3986 Section 6.
##
## Requires the `normalize` feature (default-on).
##
## ### Parameters
## - `raw_url`: Raw URL value.
##
## ### Returns
## The normalized URL string.
@cfg(feature = "normalize")
pub function normalize(raw_url) -> string
    return url_normalize(raw_url)
end

## Resolves a relative URL or path against a base URL.
##
## ### Parameters
## - `base`: Base URL value.
## - `relative`: Relative reference value.
##
## ### Returns
## The resolved absolute URL string.
pub function join(base, relative) -> string
    return url_join(base, relative)
end
