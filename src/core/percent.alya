## # url/core/percent
##
## Percent encoding and decoding (RFC 3986 / WHATWG URL).
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

## Checks whether a byte code is an unreserved character.
##
## ### Parameters
## - `code`: Byte code integer.
##
## ### Returns
## `1` for unreserved characters, `0` otherwise.
pub function _url_is_unreserved(code: int) -> int
    return when
        code >= 48 and code <= 57  => 1
        code >= 65 and code <= 90  => 1
        code >= 97 and code <= 122 => 1
        code == 45 or code == 46 or code == 95 or code == 126 => 1
        else => 0
    end
end

## Converts a 4-bit nibble to its uppercase hex character.
##
## ### Parameters
## - `nibble`: Integer in the range `0..15`.
##
## ### Returns
## The hex character string.
pub function _url_hex_char(nibble: int) -> string
    if nibble < 10
        return chr(48 + nibble)
    end
    return chr(55 + nibble)
end

## Converts a byte code to its two-character uppercase hex form.
##
## ### Parameters
## - `code`: Byte code integer.
##
## ### Returns
## The two-character hex string.
pub function _url_to_hex(code: int) -> string
    let hi = (code / 16) % 16
    let lo = code % 16
    let hi_ch = _url_hex_char(hi)
    let lo_ch = _url_hex_char(lo)
    return "{hi_ch}{lo_ch}"
end

## Converts a hex character to its numeric value.
##
## ### Parameters
## - `ch`: Hex character string.
##
## ### Returns
## The nibble value, or `-1` for non-hex input.
pub function _url_from_hex(ch: string) -> int
    let c = ord(ch)
    return when c
        is 48..57  => c - 48
        is 65..70  => c - 55
        is 97..102 => c - 87
        else       => -1
    end
end

## Standard RFC 3986 percent encoding for arbitrary text.
##
## ### Parameters
## - `text`: Input text value.
##
## ### Returns
## The percent-encoded string.
##
## ### Examples
## ```alya
## say url_encode("a b") # "a%20b"
## ```
pub function url_encode(text) -> string
    let s = str_from_ptr(text)
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        let code = char_code_at(s, i)
        if _url_is_unreserved(code) == 1
            res += chr(code)
        else
            let hex = _url_to_hex(code)
            res += "%{hex}"
        end
        i += 1
    end
    return res
end

## Standard RFC 3986 percent decoding (supports `+` as space).
##
## ### Parameters
## - `text`: Encoded input text value.
##
## ### Returns
## The decoded string.
pub function url_decode(text) -> string
    let s = str_from_ptr(text)
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch == "%" and i + 2 < slen
            let h1 = _url_from_hex(char_at(s, i + 1))
            let h2 = _url_from_hex(char_at(s, i + 2))
            if h1 >= 0 and h2 >= 0
                let code = h1 * 16 + h2
                res += chr(code)
                i += 2
            else
                res += ch
            end
        elif ch == "+"
            res += " "
        else
            res += ch
        end
        i += 1
    end
    return res
end

## Component encoding (identical to `url_encode` for unreserved characters).
##
## ### Parameters
## - `text`: Input text value.
##
## ### Returns
## The percent-encoded string.
pub function url_encode_component(text) -> string
    return url_encode(text)
end

## Component decoding without transforming `+` to space.
##
## ### Parameters
## - `text`: Encoded input text value.
##
## ### Returns
## The decoded string.
pub function url_decode_component(text) -> string
    let s = str_from_ptr(text)
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch == "%" and i + 2 < slen
            let h1 = _url_from_hex(char_at(s, i + 1))
            let h2 = _url_from_hex(char_at(s, i + 2))
            if h1 >= 0 and h2 >= 0
                let code = h1 * 16 + h2
                res += chr(code)
                i += 2
            else
                res += ch
            end
        else
            res += ch
        end
        i += 1
    end
    return res
end

## Percent-encodes a path while preserving slashes (`/`).
##
## ### Parameters
## - `text`: Input path value.
##
## ### Returns
## The encoded path string.
pub function url_encode_path(text) -> string
    let s = str_from_ptr(text)
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        let code = char_code_at(s, i)
        if ch == "/" or _url_is_unreserved(code) == 1
            res += ch
        else
            let hex = _url_to_hex(code)
            res += "%{hex}"
        end
        i += 1
    end
    return res
end
