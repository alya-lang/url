# URL Parsing and formatting (RFC 3986 / WHATWG URL)
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "./percent.alya"
import "./path.alya"

function _url_field(f)
    return str_from_ptr(f)
end

pub function url_default_port(scheme)
    let s = str_from_ptr(scheme)
    when s
        is "http", "ws" then return "80"
        is "https", "wss" then return "443"
        is "ftp" then return "21"
        is "ssh", "sftp" then return "22"
        is "telnet" then return "23"
        is "smtp" then return "25"
        is "dns" then return "53"
        is "pop3" then return "110"
        is "imap" then return "143"
        is "ldap" then return "389"
        is "redis" then return "6379"
        is "postgres", "postgresql" then return "5432"
        is "mysql" then return "3306"
        is "mongodb" then return "27017"
        else return ""
    end
end

pub function url_is_special(scheme)
    let s = str_from_ptr(scheme)
    when s
        is "http", "https", "ws", "wss", "ftp", "file" then return 1
        else return 0
    end
end

pub function url_parse(raw_url)
    let s = str_from_ptr(raw_url)
    let slen = len(s)

    # 1. Fragment
    let fragment = ""
    let hash_idx = _url_find(s, "#", 0)
    if hash_idx >= 0
        fragment = substring(s, hash_idx + 1, slen - (hash_idx + 1))
        s = substring(s, 0, hash_idx)
        slen = len(s)
    end

    # 2. Query
    let query = ""
    let q_idx = _url_find(s, "?", 0)
    if q_idx >= 0
        query = substring(s, q_idx + 1, slen - (q_idx + 1))
        s = substring(s, 0, q_idx)
        slen = len(s)
    end

    # 3. Scheme
    let scheme = ""
    let scheme_idx = _url_find(s, "://", 0)
    let is_hierarchical = 1
    if scheme_idx >= 0
        scheme = substring(s, 0, scheme_idx)
        s = substring(s, scheme_idx + 3, slen - (scheme_idx + 3))
        slen = len(s)
    else
        # Check for non-hierarchical/opaque schemes (e.g. mailto:foo@bar.com)
        let colon_idx = _url_find(s, ":", 0)
        let slash_idx = _url_find(s, "/", 0)
        if colon_idx > 0 and (slash_idx < 0 or colon_idx < slash_idx)
            scheme = substring(s, 0, colon_idx)
            s = substring(s, colon_idx + 1, slen - (colon_idx + 1))
            slen = len(s)
            is_hierarchical = 0
        end
    end

    # 4. Path vs Authority
    let host = ""
    let port = ""
    let username = ""
    let password = ""
    let path = ""

    if is_hierarchical == 0
        # Non-hierarchical (e.g. mailto:test@example.com)
        path = s
        return url_create(scheme, username, password, host, port, path, query, fragment)
    end

    let slash_idx = _url_find(s, "/", 0)
    let authority = ""
    if slash_idx >= 0
        authority = substring(s, 0, slash_idx)
        path = substring(s, slash_idx, slen - slash_idx)
    else
        authority = s
        if len(scheme) > 0
            path = "/"
        else
            path = ""
        end
    end

    # 5. Userinfo
    let at_idx = _url_find(authority, "@", 0)
    let hostport = authority
    if at_idx >= 0
        let userinfo = substring(authority, 0, at_idx)
        hostport = substring(authority, at_idx + 1, len(authority) - (at_idx + 1))
        let colon_u = _url_find(userinfo, ":", 0)
        if colon_u >= 0
            username = substring(userinfo, 0, colon_u)
            password = substring(userinfo, colon_u + 1, len(userinfo) - (colon_u + 1))
        else
            username = userinfo
        end
    end

    # 6. Host & Port (handles bracketed IPv6 [::1] or IPv4 / domains)
    if len(hostport) > 0 and char_at(hostport, 0) == "["
        let closing_bracket = _url_find(hostport, "]", 0)
        if closing_bracket >= 0
            host = substring(hostport, 0, closing_bracket + 1)
            let remainder = substring(hostport, closing_bracket + 1, len(hostport) - (closing_bracket + 1))
            if len(remainder) > 1 and char_at(remainder, 0) == ":"
                port = substring(remainder, 1, len(remainder) - 1)
            end
        else
            host = hostport
        end
    else
        let colon_h = _url_find(hostport, ":", 0)
        if colon_h >= 0
            host = substring(hostport, 0, colon_h)
            port = substring(hostport, colon_h + 1, len(hostport) - (colon_h + 1))
        else
            host = hostport
        end
    end

    return url_create(scheme, username, password, host, port, path, query, fragment)
end

pub function url_format(u: Url)
    let res = ""
    let sc = _url_field(u.scheme)
    let un = _url_field(u.username)
    let pw = _url_field(u.password)
    let h = _url_field(u.host)
    let p = _url_field(u.port)
    let pth = _url_field(u.path)
    let q = _url_field(u.query)
    let frag = _url_field(u.fragment)

    if len(sc) > 0
        if len(h) > 0 or pth == "/" or len(pth) == 0 or substring(pth, 0, 1) == "/"
            res += sc + "://"
        else
            res += sc + ":"
        end
    end

    if len(un) > 0
        res += un
        if len(pw) > 0
            res += ":" + pw
        end
        res += "@"
    end

    res += h

    if len(p) > 0
        res += ":" + p
    end

    if len(pth) > 0
        res += pth
    end

    if len(q) > 0
        res += "?" + q
    end

    if len(frag) > 0
        res += "#" + frag
    end

    return res
end

pub function url_to_string(u: Url)
    return url_format(u)
end

pub function url_origin(u: Url)
    let res = ""
    let sc = _url_field(u.scheme)
    let h = _url_field(u.host)
    let p = _url_field(u.port)

    if len(sc) > 0
        res += sc + "://"
    end
    res += h
    if len(p) > 0
        res += ":" + p
    end
    return res
end

pub function url_is_https(u: Url)
    let sc = _url_field(u.scheme)
    return sc == "https"
end

pub function url_is_http(u: Url)
    let sc = _url_field(u.scheme)
    return sc == "http"
end

pub function url_effective_port(u: Url)
    let p = _url_field(u.port)
    if len(p) > 0
        return p
    end
    let sc = _url_field(u.scheme)
    return url_default_port(sc)
end

# ═══════════════════════════════════════════════════════════════
# Struct Methods on Url
# ═══════════════════════════════════════════════════════════════

pub function Url.to_string(self: Url)
    return url_format(self)
end

pub function Url.origin(self: Url)
    return url_origin(self)
end

pub function Url.is_https(self: Url)
    return url_is_https(self)
end

pub function Url.is_http(self: Url)
    return url_is_http(self)
end

pub function Url.effective_port(self: Url)
    return url_effective_port(self)
end
