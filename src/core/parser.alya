# URL Parsing and formatting (RFC 3986 / WHATWG URL)
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "./percent.alya"
import "./path.alya"

function _url_field(f)
    return str_from_ptr(f)
end

function url_default_port(scheme)
    let s = str_from_ptr(scheme)
    if s == "http" or s == "ws"
        return "80"
    elif s == "https" or s == "wss"
        return "443"
    elif s == "ftp"
        return "21"
    elif s == "ssh" or s == "sftp"
        return "22"
    elif s == "telnet"
        return "23"
    elif s == "smtp"
        return "25"
    elif s == "dns"
        return "53"
    elif s == "pop3"
        return "110"
    elif s == "imap"
        return "143"
    elif s == "ldap"
        return "389"
    elif s == "redis"
        return "6379"
    elif s == "postgres" or s == "postgresql"
        return "5432"
    elif s == "mysql"
        return "3306"
    elif s == "mongodb"
        return "27017"
    end
    return ""
end

function url_is_special(scheme)
    let s = str_from_ptr(scheme)
    if s == "http" or s == "https" or s == "ws" or s == "wss" or s == "ftp" or s == "file"
        return 1
    end
    return 0
end

function url_parse(raw_url)
    let s = str_from_ptr(raw_url)
    let slen = len(s)

    # 1. Fragment
    let fragment = ""
    let hash_idx = _url_find(s, "#", 0)
    if hash_idx >= 0
        fragment = substring(s, hash_idx + 1, slen - (hash_idx + 1))
        s = substring(s, 0, hash_idx)
        slen = len(s)
    end

    # 2. Query
    let query = ""
    let q_idx = _url_find(s, "?", 0)
    if q_idx >= 0
        query = substring(s, q_idx + 1, slen - (q_idx + 1))
        s = substring(s, 0, q_idx)
        slen = len(s)
    end

    # 3. Scheme
    let scheme = ""
    let scheme_idx = _url_find(s, "://", 0)
    let is_hierarchical = 1
    if scheme_idx >= 0
        scheme = substring(s, 0, scheme_idx)
        s = substring(s, scheme_idx + 3, slen - (scheme_idx + 3))
        slen = len(s)
    else
        # Check for non-hierarchical/opaque schemes (e.g. mailto:foo@bar.com)
        let colon_idx = _url_find(s, ":", 0)
        let slash_idx = _url_find(s, "/", 0)
        if colon_idx > 0 and (slash_idx < 0 or colon_idx < slash_idx)
            scheme = substring(s, 0, colon_idx)
            s = substring(s, colon_idx + 1, slen - (colon_idx + 1))
            slen = len(s)
            is_hierarchical = 0
        end
    end

    # 4. Path vs Authority
    let host = ""
    let port = ""
    let username = ""
    let password = ""
    let path = ""

    if is_hierarchical == 0
        # Non-hierarchical (e.g. mailto:test@example.com)
        path = s
        return url_create(scheme, username, password, host, port, path, query, fragment)
    end

    let slash_idx = _url_find(s, "/", 0)
    let authority = ""
    if slash_idx >= 0
        authority = substring(s, 0, slash_idx)
        path = substring(s, slash_idx, slen - slash_idx)
    else
        authority = s
        if len(scheme) > 0
            path = "/"
        else
            path = ""
        end
    end

    # 5. Userinfo
    let at_idx = _url_find(authority, "@", 0)
    let hostport = authority
    if at_idx >= 0
        let userinfo = substring(authority, 0, at_idx)
        hostport = substring(authority, at_idx + 1, len(authority) - (at_idx + 1))
        let colon_u = _url_find(userinfo, ":", 0)
        if colon_u >= 0
            username = substring(userinfo, 0, colon_u)
            password = substring(userinfo, colon_u + 1, len(userinfo) - (colon_u + 1))
        else
            username = userinfo
        end
    end

    # 6. Host & Port (handles bracketed IPv6 [::1] or IPv4 / domains)
    if len(hostport) > 0 and char_at(hostport, 0) == "["
        let closing_bracket = _url_find(hostport, "]", 0)
        if closing_bracket >= 0
            host = substring(hostport, 0, closing_bracket + 1)
            let remainder = substring(hostport, closing_bracket + 1, len(hostport) - (closing_bracket + 1))
            if len(remainder) > 1 and char_at(remainder, 0) == ":"
                port = substring(remainder, 1, len(remainder) - 1)
            end
        else
            host = hostport
        end
    else
        let colon_h = _url_find(hostport, ":", 0)
        if colon_h >= 0
            host = substring(hostport, 0, colon_h)
            port = substring(hostport, colon_h + 1, len(hostport) - (colon_h + 1))
        else
            host = hostport
        end
    end

    return url_create(scheme, username, password, host, port, path, query, fragment)
end

function url_format(u)
    let res = ""
    let sc = _url_field(u.scheme)
    let un = _url_field(u.username)
    let pw = _url_field(u.password)
    let h = _url_field(u.host)
    let p = _url_field(u.port)
    let pth = _url_field(u.path)
    let q = _url_field(u.query)
    let frag = _url_field(u.fragment)

    if len(sc) > 0
        if len(h) > 0 or pth == "/" or len(pth) == 0 or substring(pth, 0, 1) == "/"
            res = res + sc + "://"
        else
            res = res + sc + ":"
        end
    end

    if len(un) > 0
        res = res + un
        if len(pw) > 0
            res = res + ":" + pw
        end
        res = res + "@"
    end

    res = res + h

    if len(p) > 0
        res = res + ":" + p
    end

    if len(pth) > 0
        res = res + pth
    end

    if len(q) > 0
        res = res + "?" + q
    end

    if len(frag) > 0
        res = res + "#" + frag
    end

    return res
end

function url_to_string(u)
    return url_format(u)
end

function url_origin(u)
    let res = ""
    let sc = _url_field(u.scheme)
    let h = _url_field(u.host)
    let p = _url_field(u.port)

    if len(sc) > 0
        res = res + sc + "://"
    end
    res = res + h
    if len(p) > 0
        res = res + ":" + p
    end
    return res
end

function url_is_https(u)
    let sc = _url_field(u.scheme)
    return sc == "https"
end

function url_is_http(u)
    let sc = _url_field(u.scheme)
    return sc == "http"
end

function url_effective_port(u)
    let p = _url_field(u.port)
    if len(p) > 0
        return p
    end
    let sc = _url_field(u.scheme)
    return url_default_port(sc)
end
