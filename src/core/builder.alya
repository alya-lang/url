## # url/core/builder
##
## Fluent URL builder implementation.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "../types.alya"
import "./path.alya"
import "./parser.alya"
import "./query.alya"

## Creates a new empty fluent URL builder.
##
## ### Returns
## The new `UrlBuilder` instance.
pub function url_builder() -> UrlBuilder
    return url_builder_create()
end

## Seeds a builder from a parsed `Url` struct.
##
## ### Parameters
## - `u`: Source `Url` instance.
##
## ### Returns
## The seeded `UrlBuilder` instance.
pub function builder_from_url(u: Url) -> UrlBuilder
    let b = url_builder_create()
    b.b_scheme = str_from_ptr(u.scheme)
    b.b_username = str_from_ptr(u.username)
    b.b_password = str_from_ptr(u.password)
    b.b_host = str_from_ptr(u.host)
    b.b_port = str_from_ptr(u.port)
    b.b_path = str_from_ptr(u.path)
    b.b_fragment = str_from_ptr(u.fragment)

    let sp = search_params_from_string(str_from_ptr(u.query))
    for entry in sp.entries
        b.b_params.push([str_from_ptr(entry[0]), str_from_ptr(entry[1])])
    end
    return b
end

## Seeds a builder by parsing a raw URL string.
##
## ### Parameters
## - `raw_url`: Raw URL value.
##
## ### Returns
## The seeded `UrlBuilder` instance.
pub function builder_from_string(raw_url) -> UrlBuilder
    let u = url_parse(raw_url)
    return builder_from_url(u)
end

## Sets the builder scheme, returning the updated builder.
##
## ### Parameters
## - `b`: Target `UrlBuilder` instance.
## - `scheme`: Scheme value.
##
## ### Returns
## The updated `UrlBuilder` instance.
pub function builder_scheme(b: UrlBuilder, scheme) -> UrlBuilder
    b.b_scheme = str_from_ptr(scheme)
    return b
end

## Sets builder credentials, returning the updated builder.
##
## ### Parameters
## - `b`: Target `UrlBuilder` instance.
## - `username`: Username value.
## - `password`: Password value.
##
## ### Returns
## The updated `UrlBuilder` instance.
pub function builder_credentials(b: UrlBuilder, username, password) -> UrlBuilder
    b.b_username = str_from_ptr(username)
    b.b_password = str_from_ptr(password)
    return b
end

