## Sets the builder path, returning the updated builder.
##
## ### Parameters
## - `b`: Target `UrlBuilder` instance.
## - `path`: Path value.
##
## ### Returns
## The updated `UrlBuilder` instance.
pub function builder_path(b: UrlBuilder, path) -> UrlBuilder
    b.b_path = str_from_ptr(path)
    return b
end

## Appends a segment to the builder path, returning the updated builder.
##
## ### Parameters
## - `b`: Target `UrlBuilder` instance.
## - `segment`: Path segment value.
##
## ### Returns
## The updated `UrlBuilder` instance.
pub function builder_append_path(b: UrlBuilder, segment) -> UrlBuilder
    let s = str_from_ptr(segment)
    b.b_path = url_join_path(b.b_path, s)
    return b
end

## Appends a query parameter, returning the updated builder.
##
## ### Parameters
## - `b`: Target `UrlBuilder` instance.
## - `key`: Parameter key value.
## - `value`: Parameter value.
##
## ### Returns
## The updated `UrlBuilder` instance.
pub function builder_param(b: UrlBuilder, key, value) -> UrlBuilder
    b.b_params.push([str_from_ptr(key), str_from_ptr(value)])
    return b
end

## Merges a query string into the builder, returning the updated builder.
##
## ### Parameters
## - `b`: Target `UrlBuilder` instance.
## - `query_str`: Raw query value.
##
## ### Returns
## The updated `UrlBuilder` instance.
pub function builder_query(b: UrlBuilder, query_str) -> UrlBuilder
    let sp = search_params_from_string(query_str)
    for entry in sp.entries
        b.b_params.push(entry)
    end
    return b
end

## Sets the builder fragment, returning the updated builder.
##
## ### Parameters
## - `b`: Target `UrlBuilder` instance.
## - `fragment`: Fragment value.
##
## ### Returns
## The updated `UrlBuilder` instance.
pub function builder_fragment(b: UrlBuilder, fragment) -> UrlBuilder
    b.b_fragment = str_from_ptr(fragment)
    return b
end

## Builds a `Url` struct from the builder state.
##
## ### Parameters
## - `b`: Target `UrlBuilder` instance.
##
## ### Returns
## The built `Url` instance.
pub function builder_build(b: UrlBuilder) -> Url
    let sp = search_params_create(b.b_params)
    let q_str = search_params_to_string(sp)
    let pth = b.b_path
    if len(pth) == 0 and len(b.b_scheme) > 0
        pth = "/"
    end
    return url_create(b.b_scheme, b.b_username, b.b_password, b.b_host, b.b_port, pth, q_str, b.b_fragment)
end

## Builds and formats the builder state into a URL string.
##
## ### Parameters
## - `b`: Target `UrlBuilder` instance.
##
## ### Returns
## The built URL string.
pub function builder_to_string(b: UrlBuilder) -> string
    let u = builder_build(b)
    return url_format(u)
end

