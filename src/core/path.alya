## # url/core/path
##
## URL path manipulation, dot-segment normalization, and reference resolution.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Implements RFC 3986 Section 5.2.4 dot-segment removal and Section 5
## reference resolution shared by the parser and builder.

import "../types.alya"

## Finds the first index of a target substring at or after a start index.
##
## ### Parameters
## - `s`: Haystack string.
## - `target`: Needle string.
## - `start_idx`: Starting index integer.
##
## ### Returns
## The match index, or `-1` when absent (`start_idx` for empty targets).
pub function _url_find(s: string, target: string, start_idx: int) -> int
    let slen = len(s)
    let tlen = len(target)
    if tlen == 0
        return start_idx
    end
    let i = start_idx
    while i + tlen <= slen
        if substring(s, i, tlen) == target
            return i
        end
        i += 1
    end
    return -1
end

## Splits a `Url` struct into non-empty path segments.
##
## ### Parameters
## - `u`: Target `Url` instance.
##
## ### Returns
## Array of non-empty segment strings.
pub function url_path_segments(u: Url) -> array
    let p = str_from_ptr(u.path)
    let plen = len(p)
    if plen == 0
        return []
    end
    let raw_segs = split(p, "/")
    let res = []
    for seg in raw_segs
        let s_seg = str_from_ptr(seg)
        if len(s_seg) > 0
            res.push(s_seg)
        end
    end
    return res
end

## Removes dot segments per RFC 3986 Section 5.2.4.
##
## ### Parameters
## - `path`: Raw path value.
##
## ### Returns
## The normalized path string.
##
## ### Examples
## ```alya
## say url_remove_dot_segments("/a/b/../c") # "/a/c"
## ```
pub function url_remove_dot_segments(path) -> string
    let p = str_from_ptr(path)
    let plen = len(p)
    if plen == 0
        return ""
    end

    let starts_slash = char_at(p, 0) == "/"
    let ends_slash = char_at(p, plen - 1) == "/"
    let ends_dot = 0
    if plen >= 2 and substring(p, plen - 2, 2) == "/."
        ends_dot = 1
    elif plen >= 3 and substring(p, plen - 3, 3) == "/.."
        ends_dot = 1
    end
    let should_end_slash = ends_slash == 1 or ends_dot == 1

    let raw_segs = split(p, "/")
    let stack = []

    for seg in raw_segs
        let s_seg = str_from_ptr(seg)
        if s_seg == "" or s_seg == "."
            # ignore empty or current directory
        elif s_seg == ".."
            if len(stack) > 0
                stack.pop()
            end
        else
            stack.push(s_seg)
        end
    end

    let out = ""
    for item in stack
        let seg_str = str_from_ptr(item)
        out += "/{seg_str}"
    end

    if len(out) == 0
        if starts_slash == 1
            return "/"
        end
        return ""
    end

    if starts_slash == 0 and len(out) > 1
        out = substring(out, 1, len(out) - 1)
    end

    if should_end_slash == 1 and char_at(out, len(out) - 1) != "/"
        out += "/"
    end

    return out
end

## Joins two path strings without duplicate slashes.
##
## ### Parameters
## - `base_path`: Base path value.
## - `rel_path`: Relative path value.
##
## ### Returns
## The joined path string.
pub function url_join_path(base_path, rel_path) -> string
    let b = str_from_ptr(base_path)
    let r = str_from_ptr(rel_path)
    let blen = len(b)
    let rlen = len(r)

    if blen == 0
        return r
    end
    if rlen == 0
        return b
    end

    let b_ends_slash = char_at(b, blen - 1) == "/"
    let r_starts_slash = char_at(r, 0) == "/"

    if b_ends_slash == 1 and r_starts_slash == 1
        return substring(b, 0, blen - 1) + r
    elif b_ends_slash == 0 and r_starts_slash == 0
        return "{b}/{r}"
    else
        return b + r
    end
end

## Resolves a relative URL against a base URL (RFC 3986 Section 5).
##
## ### Parameters
## - `base`: Base URL value.
## - `relative`: Relative reference value.
##
## ### Returns
## The resolved absolute URL string.
##
## ### Examples
## ```alya
## say url_join("https://a/b/c", "../d") # "https://a/d"
## ```
pub function url_join(base, relative) -> string
    let b = str_from_ptr(base)
    let r = str_from_ptr(relative)
    let blen = len(b)
    let rlen = len(r)

    if blen == 0
        return r
    end
    if rlen == 0
        return b
    end

    # If relative is an absolute URL with scheme
    let r_scheme_idx = _url_find(r, "://", 0)
    if r_scheme_idx >= 0
        return r
    end

    # Check if base has scheme
    let b_scheme_idx = _url_find(b, "://", 0)
    if b_scheme_idx < 0
        # Neither has scheme: fallback to simple path joining
        return url_join_path(b, r)
    end

    let scheme = substring(b, 0, b_scheme_idx)
    let b_after_scheme = substring(b, b_scheme_idx + 3, blen - (b_scheme_idx + 3))

    # Protocol-relative URL: //example.com/foo
    if len(r) >= 2 and substring(r, 0, 2) == "//"
        return "{scheme}:{r}"
    end

    # Find authority and path in base
    let b_slash_idx = _url_find(b_after_scheme, "/", 0)
    let authority = ""
    let b_path = ""
    if b_slash_idx >= 0
        authority = substring(b_after_scheme, 0, b_slash_idx)
        b_path = substring(b_after_scheme, b_slash_idx, len(b_after_scheme) - b_slash_idx)
    else
        authority = b_after_scheme
        b_path = "/"
    end

    # Strip query and fragment from base path
    let q_idx = _url_find(b_path, "?", 0)
    if q_idx >= 0
        b_path = substring(b_path, 0, q_idx)
    end
    let h_idx = _url_find(b_path, "#", 0)
    if h_idx >= 0
        b_path = substring(b_path, 0, h_idx)
    end

    # 1. Query-only relative: ?q=1
    if char_at(r, 0) == "?"
        return "{scheme}://{authority}{b_path}{r}"
    end

    # 2. Fragment-only relative: #section
    if char_at(r, 0) == "#"
        return b + r
    end

    # 3. Absolute path relative: /new/path
    if char_at(r, 0) == "/"
        let norm_path = url_remove_dot_segments(r)
        return "{scheme}://{authority}{norm_path}"
    end

    # 4. Relative path: dir/file or ../file
    let last_slash = -1
    let bplen = len(b_path)
    let k = bplen - 1
    while k >= 0
        if char_at(b_path, k) == "/"
            last_slash = k
            break
        end
        k -= 1
    end

    let base_dir = "/"
    if last_slash >= 0
        base_dir = substring(b_path, 0, last_slash + 1)
    end

    let merged = base_dir + r
    let clean_path = url_remove_dot_segments(merged)
    return "{scheme}://{authority}{clean_path}"
end
