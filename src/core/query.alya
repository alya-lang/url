## # url/core/query
##
## Query string parsing, formatting, and WHATWG UrlSearchParams.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "../types.alya"
import "./percent.alya"
import "./path.alya"
import "./parser.alya"

## Formats a map into a percent-encoded query string.
##
## ### Parameters
## - `m`: Query entry map.
##
## ### Returns
## The encoded query string (without `?`).
pub function url_format_query(m) -> string
    let out = ""
    let first = true
    for k, v in m
        let enc_k = url_encode(str_from_ptr(k))
        let enc_v = url_encode(str_from_ptr(v))
        let pair = "{enc_k}={enc_v}"
        if not first
            out += "&{pair}"
        else
            out = pair
            first = false
        end
    end
    return out
end

## Parses a query string into a map.
##
## ### Parameters
## - `query_str`: Raw query value (leading `?` tolerated).
##
## ### Returns
## The decoded entry map.
pub function url_parse_query(query_str)
    let q = str_from_ptr(query_str)
    let qlen = len(q)
    if qlen == 0
        return {}
    end

    if char_at(q, 0) == "?"
        q = substring(q, 1, qlen - 1)
        qlen = len(q)
    end

    let res = {}
    let start = 0
    let i = 0

    while i <= qlen
        let is_sep = 0
        if i == qlen
            is_sep = 1
        elif char_at(q, i) == "&"
            is_sep = 1
        end

        if is_sep == 1
            if i > start
                let pair = substring(q, start, i - start)
                let eq_idx = _url_find(pair, "=", 0)
                if eq_idx >= 0
                    let k = substring(pair, 0, eq_idx)
                    let v = substring(pair, eq_idx + 1, len(pair) - (eq_idx + 1))
                    let dec_k = url_decode(k)
                    let dec_v = url_decode(v)
                    res[dec_k] = dec_v
                else
                    let dec_k = url_decode(pair)
                    res[dec_k] = ""
                end
            end
            start = i + 1
        end
        i += 1
    end

    return res
end

## Returns a decoded query parameter value from a raw URL.
##
## ### Parameters
## - `raw_url`: Raw URL value.
## - `key`: Parameter key value.
##
## ### Returns
## The decoded value string (empty when absent).
pub function url_get_query_param(raw_url, key) -> string
    let u = url_parse(raw_url)
    let q_map = url_parse_query(u.query)
    let k = str_from_ptr(key)
    if k in q_map
        return str_from_ptr(q_map[k])
    end
    return ""
end

## Checks whether a raw URL carries a query parameter.
##
## ### Parameters
## - `raw_url`: Raw URL value.
## - `key`: Parameter key value.
##
## ### Returns
## `1` when present, `0` otherwise.
pub function url_has_query_param(raw_url, key) -> int
    let u = url_parse(raw_url)
    let q_map = url_parse_query(u.query)
    let k = str_from_ptr(key)
    return if k in q_map then 1 else 0
end

## Sets (or replaces) a query parameter, returning the rebuilt URL.
##
## ### Parameters
## - `raw_url`: Raw URL value.
## - `key`: Parameter key value.
## - `value`: Parameter value.
##
## ### Returns
## The rebuilt URL string.
pub function url_set_query_param(raw_url, key, value) -> string
    let u = url_parse(raw_url)
    let q_map = url_parse_query(u.query)
    let k = str_from_ptr(key)
    let v = str_from_ptr(value)
    q_map[k] = v
    let nq = url_format_query(q_map)
    u.query = nq
    return url_format(u)
end

## Removes a query parameter, returning the rebuilt URL.
##
## ### Parameters
## - `raw_url`: Raw URL value.
## - `key`: Parameter key value.
##
## ### Returns
## The rebuilt URL string.
pub function url_remove_query_param(raw_url, key) -> string
    let u = url_parse(raw_url)
    let q_map = url_parse_query(u.query)
    let k_target = str_from_ptr(key)
    let new_map = {}
    for k, v in q_map
        if k != k_target
            new_map[k] = v
        end
    end
    let nq = url_format_query(new_map)
    u.query = nq
    return url_format(u)
end

## Appends a query parameter, returning the rebuilt URL.
##
## ### Parameters
## - `raw_url`: Raw URL value.
## - `key`: Parameter key value.
## - `value`: Parameter value.
##
## ### Returns
## The rebuilt URL string.
pub function url_append_query_param(raw_url, key, value) -> string
    let u = url_parse(raw_url)
    let enc_k = url_encode(str_from_ptr(key))
    let enc_v = url_encode(str_from_ptr(value))
    let pair = "{enc_k}={enc_v}"

    let current_q = str_from_ptr(u.query)
    if len(current_q) > 0
        u.query = "{current_q}&{pair}"
    else
        u.query = pair
    end
    return url_format(u)
end

# ═══════════════════════════════════════════════════════════════
# WHATWG-style UrlSearchParams API
# ═══════════════════════════════════════════════════════════════

## Creates an empty `UrlSearchParams` container.
##
## ### Returns
## The new container instance.
pub function search_params_new() -> UrlSearchParams
    return search_params_create([])
end

## Parses a query string into a `UrlSearchParams` container.
##
## ### Parameters
## - `query_str`: Raw query value (leading `?` tolerated).
##
## ### Returns
## The populated container instance.
pub function search_params_from_string(query_str) -> UrlSearchParams
    let q = str_from_ptr(query_str)
    let qlen = len(q)
    let entries = []
    if qlen == 0
        return search_params_create(entries)
    end

    if char_at(q, 0) == "?"
        q = substring(q, 1, qlen - 1)
        qlen = len(q)
    end

    let start = 0
    let i = 0

    while i <= qlen
        let is_sep = 0
        if i == qlen
            is_sep = 1
        elif char_at(q, i) == "&"
            is_sep = 1
        end

        if is_sep == 1
            if i > start
                let pair = substring(q, start, i - start)
                let eq_idx = _url_find(pair, "=", 0)
                if eq_idx >= 0
                    let k = substring(pair, 0, eq_idx)
                    let v = substring(pair, eq_idx + 1, len(pair) - (eq_idx + 1))
                    entries.push([url_decode(k), url_decode(v)])
                else
                    entries.push([url_decode(pair), ""])
                end
            end
            start = i + 1
        end
        i += 1
    end

    return search_params_create(entries)
end

## Builds a `UrlSearchParams` container from a map.
##
## ### Parameters
## - `m`: Entry map.
##
## ### Returns
## The populated container instance.
pub function search_params_from_map(m) -> UrlSearchParams
    let entries = []
    for k, v in m
        entries.push([str_from_ptr(k), str_from_ptr(v)])
    end
    return search_params_create(entries)
end

## Returns the first value for a key, or `""` when absent.
##
## ### Parameters
## - `sp`: Target container instance.
## - `key`: Key value.
##
## ### Returns
## The first value string.
pub function search_params_get(sp: UrlSearchParams, key) -> string
    let k_target = str_from_ptr(key)
    for pair in sp.entries
        if str_from_ptr(pair[0]) == k_target
            return str_from_ptr(pair[1])
        end
    end
    return ""
end

## Returns every value for a key in insertion order.
##
## ### Parameters
## - `sp`: Target container instance.
## - `key`: Key value.
##
## ### Returns
## Array of value strings.
pub function search_params_get_all(sp: UrlSearchParams, key) -> array
    let k_target = str_from_ptr(key)
    let res = []
    for pair in sp.entries
        if str_from_ptr(pair[0]) == k_target
            res.push(str_from_ptr(pair[1]))
        end
    end
    return res
end

## Checks whether a key exists in the container.
##
## ### Parameters
## - `sp`: Target container instance.
## - `key`: Key value.
##
## ### Returns
## `1` when present, `0` otherwise.
pub function search_params_has(sp: UrlSearchParams, key) -> int
    let k_target = str_from_ptr(key)
    for pair in sp.entries
        if str_from_ptr(pair[0]) == k_target
            return 1
        end
    end
    return 0
end

## Sets a key, replacing existing entries and appending when absent.
##
## ### Parameters
## - `sp`: Target container instance.
## - `key`: Key value.
## - `value`: Value to store.
pub function search_params_set(sp: UrlSearchParams, key, value)
    let k_target = str_from_ptr(key)
    let v_val = str_from_ptr(value)
    let new_entries = []
    let set_done = 0

    for pair in sp.entries
        if str_from_ptr(pair[0]) == k_target
            if set_done == 0
                new_entries.push([k_target, v_val])
                set_done = 1
            end
        else
            new_entries.push(pair)
        end
    end

    if set_done == 0
        new_entries.push([k_target, v_val])
    end

    sp.entries = new_entries
end

## Appends a key-value pair without replacing existing entries.
##
## ### Parameters
## - `sp`: Target container instance.
## - `key`: Key value.
## - `value`: Value to store.
pub function search_params_append(sp: UrlSearchParams, key, value)
    sp.entries.push([str_from_ptr(key), str_from_ptr(value)])
end

## Deletes every entry for a key.
##
## ### Parameters
## - `sp`: Target container instance.
## - `key`: Key value.
pub function search_params_delete(sp: UrlSearchParams, key)
    let k_target = str_from_ptr(key)
    let new_entries = []
    for pair in sp.entries
        if str_from_ptr(pair[0]) != k_target
            new_entries.push(pair)
        end
    end
    sp.entries = new_entries
end

# Lexicographic string comparator for parameter sorting.
function _str_cmp(s1: string, s2: string) -> int
    let len1 = len(s1)
    let len2 = len(s2)
    let min_len = if len1 < len2 then len1 else len2
    let i = 0
    while i < min_len
        let c1 = char_code_at(s1, i)
        let c2 = char_code_at(s2, i)
        if c1 < c2
            return -1
        elif c1 > c2
            return 1
        end
        i += 1
    end
    if len1 < len2
        return -1
    elif len1 > len2
        return 1
    end
    return 0
end

## Sorts container entries by key (stable bubble sort).
##
## ### Parameters
## - `sp`: Target container instance.
pub function search_params_sort(sp: UrlSearchParams)
    let n = len(sp.entries)
    let i = 0
    while i < n
        let j = 0
        while j < n - i - 1
            let k1 = str_from_ptr(sp.entries[j][0])
            let k2 = str_from_ptr(sp.entries[j + 1][0])
            if _str_cmp(k1, k2) > 0
                let temp = sp.entries[j]
                sp.entries[j] = sp.entries[j + 1]
                sp.entries[j + 1] = temp
            end
            j += 1
        end
        i += 1
    end
end

## Serializes the container into an encoded query string.
##
## ### Parameters
## - `sp`: Target container instance.
##
## ### Returns
## The encoded query string (without `?`).
pub function search_params_to_string(sp: UrlSearchParams) -> string
    let out = ""
    let first = true
    for pair in sp.entries
        let k = url_encode(str_from_ptr(pair[0]))
        let v = url_encode(str_from_ptr(pair[1]))
        let item = "{k}={v}"
        if not first
            out += "&{item}"
        else
            out = item
            first = false
        end
    end
    return out
end

## Converts the container into a first-wins entry map.
##
## ### Parameters
## - `sp`: Target container instance.
##
## ### Returns
## The entry map.
pub function search_params_to_map(sp: UrlSearchParams)
    let m = {}
    for pair in sp.entries
        let k = str_from_ptr(pair[0])
        let v = str_from_ptr(pair[1])
        if k not in m
            m[k] = v
        end
    end
    return m
end

## Returns deduplicated keys in insertion order.
##
## ### Parameters
## - `sp`: Target container instance.
##
## ### Returns
## Array of key strings.
pub function search_params_keys(sp: UrlSearchParams) -> array
    let res = []
    let seen = {}
    for pair in sp.entries
        let k = str_from_ptr(pair[0])
        if k not in seen
            seen[k] = 1
            res.push(k)
        end
    end
    return res
end

## Returns the entry count of the container.
##
## ### Parameters
## - `sp`: Target container instance.
##
## ### Returns
## The entry count integer.
pub function search_params_len(sp: UrlSearchParams) -> int
    return len(sp.entries)
end

## Removes every entry from the container.
##
## ### Parameters
## - `sp`: Target container instance.
pub function search_params_clear(sp: UrlSearchParams)
    sp.entries = []
end

# ═══════════════════════════════════════════════════════════════
# Struct Methods on UrlSearchParams
# ═══════════════════════════════════════════════════════════════

## Returns the first value for a key, or `""` when absent.
##
## ### Parameters
## - `self`: The target container instance.
## - `key`: Key value.
##
## ### Returns
## The first value string.
pub function UrlSearchParams.get(self: UrlSearchParams, key) -> string
    return search_params_get(self, key)
end

## Returns every value for a key in insertion order.
##
## ### Parameters
## - `self`: The target container instance.
## - `key`: Key value.
##
## ### Returns
## Array of value strings.
pub function UrlSearchParams.get_all(self: UrlSearchParams, key) -> array
    return search_params_get_all(self, key)
end

## Checks whether a key exists in this container.
##
## ### Parameters
## - `self`: The target container instance.
## - `key`: Key value.
##
## ### Returns
## `1` when present, `0` otherwise.
pub function UrlSearchParams.has(self: UrlSearchParams, key) -> int
    return search_params_has(self, key)
end

## Sets a key, returning the updated container.
##
## ### Parameters
## - `self`: The target container instance.
## - `key`: Key value.
## - `value`: Value to store.
##
## ### Returns
## The updated container instance.
pub function UrlSearchParams.set(self: UrlSearchParams, key, value) -> UrlSearchParams
    search_params_set(self, key, value)
    return self
end

## Appends a pair, returning the updated container.
##
## ### Parameters
## - `self`: The target container instance.
## - `key`: Key value.
## - `value`: Value to store.
##
## ### Returns
## The updated container instance.
pub function UrlSearchParams.append(self: UrlSearchParams, key, value) -> UrlSearchParams
    search_params_append(self, key, value)
    return self
end

## Deletes a key, returning the updated container.
##
## ### Parameters
## - `self`: The target container instance.
## - `key`: Key value.
##
## ### Returns
## The updated container instance.
pub function UrlSearchParams.delete(self: UrlSearchParams, key) -> UrlSearchParams
    search_params_delete(self, key)
    return self
end

## Sorts entries by key, returning the updated container.
##
## ### Parameters
## - `self`: The target container instance.
##
## ### Returns
## The updated container instance.
pub function UrlSearchParams.sort(self: UrlSearchParams) -> UrlSearchParams
    search_params_sort(self)
    return self
end

## Serializes this container into an encoded query string.
##
## ### Parameters
## - `self`: The target container instance.
##
## ### Returns
## The encoded query string (without `?`).
pub function UrlSearchParams.to_string(self: UrlSearchParams) -> string
    return search_params_to_string(self)
end

## Converts this container into a first-wins entry map.
##
## ### Parameters
## - `self`: The target container instance.
##
## ### Returns
## The entry map.
pub function UrlSearchParams.to_map(self: UrlSearchParams)
    return search_params_to_map(self)
end

## Returns deduplicated keys in insertion order.
##
## ### Parameters
## - `self`: The target container instance.
##
## ### Returns
## Array of key strings.
pub function UrlSearchParams.keys(self: UrlSearchParams) -> array
    return search_params_keys(self)
end

## Returns the entry count of this container.
##
## ### Parameters
## - `self`: The target container instance.
##
## ### Returns
## The entry count integer.
pub function UrlSearchParams.len(self: UrlSearchParams) -> int
    return search_params_len(self)
end

## Clears this container, returning the updated instance.
##
## ### Parameters
## - `self`: The target container instance.
##
## ### Returns
## The updated container instance.
pub function UrlSearchParams.clear(self: UrlSearchParams) -> UrlSearchParams
    search_params_clear(self)
    return self
end
