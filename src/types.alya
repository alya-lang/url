## # url/types
##
## Types and data structures for the url package.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Defines scheme discriminators, the `Url` model, search parameters, and
## the fluent builder record.

## Public URL scheme enumeration.
pub enum UrlScheme
    HTTP = 1,
    HTTPS = 2,
    WS = 3,
    WSS = 4,
    FTP = 5,
    FILE = 6
end

## Core URL structure with WHATWG field access (`.scheme`, `.host`, ...).
##
## ### Fields
## - `scheme`: Scheme string (e.g. `"https"`).
## - `username`: Userinfo username string.
## - `password`: Userinfo password string.
## - `host`: Host string (domain, IPv4, or bracketed IPv6).
## - `port`: Port string (empty when absent).
## - `path`: Path string.
## - `query`: Raw query string (without `?`).
## - `fragment`: Fragment string (without `#`).
pub struct Url
    scheme: string,
    username: string,
    password: string,
    host: string,
    port: string,
    path: string,
    query: string,
    fragment: string
end

## Factory constructor creating a `Url` struct from components.
##
## ### Parameters
## - `scheme`: Scheme string. Defaults to `""`.
## - `username`: Userinfo username. Defaults to `""`.
## - `password`: Userinfo password. Defaults to `""`.
## - `host`: Host string. Defaults to `""`.
## - `port`: Port string. Defaults to `""`.
## - `path`: Path string. Defaults to `""`.
## - `query`: Raw query string. Defaults to `""`.
## - `fragment`: Fragment string. Defaults to `""`.
##
## ### Returns
## The new `Url` instance.
pub function url_create(scheme: string = "", username: string = "", password: string = "", host: string = "", port: string = "", path: string = "", query: string = "", fragment: string = "") -> Url
    return Url { scheme: scheme, username: username, password: password, host: host, port: port, path: path, query: query, fragment: fragment }
end

## WHATWG-style search parameters container preserving ordered pairs.
##
## ### Fields
## - `entries`: Ordered `[key, value]` pair array.
pub struct UrlSearchParams
    entries: Any[]
end

## Factory constructor creating a `UrlSearchParams` container.
##
## ### Parameters
## - `entries`: Ordered `[key, value]` pair array. Defaults to `[]`.
##
## ### Returns
## The new `UrlSearchParams` instance.
pub function search_params_create(entries: Any[] = []) -> UrlSearchParams
    return UrlSearchParams { entries: entries }
end

## Fluent URL builder record.
##
## ### Fields
## - `b_scheme`: Scheme string under construction.
## - `b_username`: Username string under construction.
## - `b_password`: Password string under construction.
## - `b_host`: Host string under construction.
## - `b_port`: Port string under construction.
## - `b_path`: Path string under construction.
## - `b_params`: Accumulated `[key, value]` pair array.
## - `b_fragment`: Fragment string under construction.
pub struct UrlBuilder
    b_scheme: string,
    b_username: string,
    b_password: string,
    b_host: string,
    b_port: string,
    b_path: string,
    b_params: array,
    b_fragment: string
end

## Factory constructor creating an empty `UrlBuilder`.
##
## ### Returns
## The new `UrlBuilder` instance.
pub function url_builder_create() -> UrlBuilder
    return UrlBuilder { b_scheme: "", b_username: "", b_password: "", b_host: "", b_port: "", b_path: "", b_params: [], b_fragment: "" }
end
