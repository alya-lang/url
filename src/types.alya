# Types and data structures for url package
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Core URL structure supporting both modern field access (.scheme, .host, etc.)
# and 100% backward compatibility with stdlib/url (.url_scheme, .url_host, etc.)
struct Url
    scheme
    username
    password
    host
    port
    path
    query
    fragment
    url_scheme
    url_username
    url_password
    url_host
    url_port
    url_path
    url_query
    url_fragment
end

# Constructor for Url struct populating both modern and legacy fields
function url_create(scheme = "", username = "", password = "", host = "", port = "", path = "", query = "", fragment = "")
    return Url(scheme, username, password, host, port, path, query, fragment, scheme, username, password, host, port, path, query, fragment)
end

# WHATWG-style search parameters container preserving ordered key-value pairs
struct UrlSearchParams
    entries
end

function search_params_create(entries = [])
    return UrlSearchParams(entries)
end

# Fluent URL Builder structure
struct UrlBuilder
    b_scheme
    b_username
    b_password
    b_host
    b_port
    b_path
    b_params
    b_fragment
end

function url_builder_create()
    return UrlBuilder("", "", "", "", "", "", [], "")
end
